/*
 * Colemak-DH V3 for the MX Corne (Typeractive, ZMK).
 * Generated by corne/make_zmk.py from corne/choc/Colemak-DH-V3.vil; edit the .vil or the script, not this file.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            display-name = "Base";
            bindings = <
            &kp ESC   &kp Q     &kp W     &kp F     &kp P     &kp B       &kp J     &kp L     &kp U     &kp Y     &kp SEMI  &kp PSCRN
            &kp LSHFT &kp A     &kp R     &kp S     &kp T     &kp G       &kp M     &kp N     &kp E     &kp I     &kp O     &kp SQT
            &kp LCTRL &kp Z     &kp X     &kp C     &kp D     &kp V       &kp K     &kp H     &kp COMMA &kp DOT   &kp FSLH  &kp RCTRL
                                          &kp LALT  &kp SPACE &lt 1 TAB   &mo 1     &kp BSPC  &kp RET
            >;
        };

        layer_1 {
            display-name = "Lower";
            bindings = <
            &trans        &kp LS(N8)    &kp N1        &kp N2        &kp N3        &kp LS(EQUAL)   &kp MINUS     &kp LS(LBKT)  &kp LS(RBKT)  &kp LS(N9)    &kp LS(N0)    &kp BSPC
            &trans        &kp FSLH      &kp N4        &kp N5        &kp N6        &kp N0          &kp LEFT      &kp DOWN      &kp UP        &kp RIGHT     &kp LBKT      &kp RBKT
            &trans        &kp EQUAL     &kp N7        &kp N8        &kp N9        &kp DOT         &kp HOME      &kp PG_DN     &kp PG_UP     &kp END       &kp BSLH      &kp GRAVE
                                                      &kp LGUI      &trans        &mo 2           &mo 2         &kp DEL       &trans
            >;
        };

        layer_2 {
            display-name = "BT";
        // Hold both inner thumbs.
        // BT0-BT4: pick a Bluetooth slot. BTCLR: forget the current slot's pairing.
        // USB / BLE: where keys go when both are connected. UNLOCK: lets ZMK Studio change the keymap.
        // BOOT: the outer top key on each half puts that half in flashing mode (same as double-tapping reset).
            bindings = <
            &bootloader    &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3   &bt BT_SEL 4     &kp F1         &kp F2         &kp F3         &kp F4         &kp C_VOL_UP   &bootloader
            &studio_unlock &none          &none          &none          &none          &none            &kp F5         &kp F6         &kp F7         &kp F8         &kp C_VOL_DN   &none
            &bt BT_CLR     &out OUT_USB   &out OUT_BLE   &none          &none          &none            &kp F9         &kp F10        &kp F11        &kp F12        &kp C_MUTE     &none
                                                         &trans         &trans         &trans           &trans         &trans         &trans
            >;
        };
    };
};
