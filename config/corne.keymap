/*
 * Colemak-DH for the Typeractive Corne (Choc V1, ZMK). Edit this file directly, then commit and push to build.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    macros {
        // Layer keys that also hold F21 (Lower) or F22 (BT) while held, so CorneHUD on the computer can show the
        // layer the moment a thumb goes down. CorneHUD hides these keys from other programs; without CorneHUD,
        // Windows and apps ignore F21/F22.
        lower_sig: lower_sig {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings
                = <&macro_press &mo 1 &kp F21>
                , <&macro_pause_for_release>
                , <&macro_release &mo 1 &kp F21>;
        };

        bt_sig: bt_sig {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings
                = <&macro_press &mo 2 &kp F22>
                , <&macro_pause_for_release>
                , <&macro_release &mo 2 &kp F22>;
        };

        m_bt0: m_bt0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0>;
        };

        m_bt1: m_bt1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1>;
        };

        m_bt2: m_bt2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 2>;
        };

        m_bt3: m_bt3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 3>;
        };

        m_bt4: m_bt4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 4>;
        };

        m_btclr: m_btclr {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_CLR>;
        };

        m_usb: m_usb {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_USB>;
        };

        m_ble: m_ble {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE>;
        };
    };

    behaviors {
        // Left inner thumb: tap for Tab, hold for Lower (+ F21 for CorneHUD). Same timing as ZMK's built-in &lt.
        lt_lower: lt_lower {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&lower_sig>, <&kp>;
        };

        // Keys that only act when held for 500 ms; a tap does nothing.
        held_bt0: held_bt0 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <500>;
            bindings = <&m_bt0>, <&none>;
        };

        held_bt1: held_bt1 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <500>;
            bindings = <&m_bt1>, <&none>;
        };

        held_bt2: held_bt2 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <500>;
            bindings = <&m_bt2>, <&none>;
        };

        held_bt3: held_bt3 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <500>;
            bindings = <&m_bt3>, <&none>;
        };

        held_bt4: held_bt4 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <500>;
            bindings = <&m_bt4>, <&none>;
        };

        held_btclr: held_btclr {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <500>;
            bindings = <&m_btclr>, <&none>;
        };

        held_usb: held_usb {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <500>;
            bindings = <&m_usb>, <&none>;
        };

        held_ble: held_ble {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <500>;
            bindings = <&m_ble>, <&none>;
        };

        held_boot: held_boot {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <500>;
            bindings = <&bootloader>, <&none>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            display-name = "Base";
            bindings = <
            &kp ESC   &kp Q     &kp W     &kp F     &kp P     &kp B       &kp J     &kp L     &kp U     &kp Y     &kp SEMI  &kp PSCRN
            &kp LSHFT &kp A     &kp R     &kp S     &kp T     &kp G       &kp M     &kp N     &kp E     &kp I     &kp O     &kp SQT
            &kp LCTRL &kp Z     &kp X     &kp C     &kp D     &kp V       &kp K     &kp H     &kp COMMA &kp DOT   &kp FSLH  &kp RCTRL
                                    &kp LALT  &kp SPACE &lt_lower 0 TAB   &lower_sig  &kp BSPC  &kp RET
            >;
        };

        layer_1 {
            display-name = "Lower";
            bindings = <
            &trans        &kp LS(N8)    &kp N1        &kp N2        &kp N3        &kp LS(EQUAL)   &kp MINUS     &kp LS(LBKT)  &kp LS(RBKT)  &kp LS(N9)    &kp LS(N0)    &kp DEL
            &trans        &kp FSLH      &kp N4        &kp N5        &kp N6        &kp N0          &kp LEFT      &kp DOWN      &kp UP        &kp RIGHT     &kp LBKT      &kp RBKT
            &trans        &kp EQUAL     &kp N7        &kp N8        &kp N9        &kp DOT         &kp HOME      &kp PG_DN     &kp PG_UP     &kp END       &kp BSLH      &kp GRAVE
                                                      &kp LGUI      &trans        &bt_sig         &bt_sig       &trans        &trans
            >;
        };

        layer_2 {
            display-name = "BT";
            // Hold both inner thumbs. The Bluetooth, USB/BLE and BOOT keys only act when held for half a second,
            // so brushing them while typing does nothing.
            // Right bottom row: BT0-BT4 pick a Bluetooth slot, BTCLR forgets the current slot's pairing.
            // Left: BOOT (top outer) = flashing mode for the left half, Mute / Vol- / Vol+ (top row, inner three),
            // UNLOCK (home outer) = let ZMK Studio in, USB / BLE (bottom row) = where keys go when both are connected.
            bindings = <
            &held_boot 0 0  &none           &none           &kp C_MUTE      &kp C_VOL_DN    &kp C_VOL_UP      &kp F1          &kp F2          &kp F3          &kp F4          &kp F5          &kp F6
            &studio_unlock  &none           &none           &none           &none           &none             &kp F7          &kp F8          &kp F9          &kp F10         &kp F11         &kp F12
            &none           &held_usb 0 0   &held_ble 0 0   &none           &none           &none             &held_bt0 0 0   &held_bt1 0 0   &held_bt2 0 0   &held_bt3 0 0   &held_bt4 0 0   &held_btclr 0 0
                                                            &trans          &trans          &trans            &trans          &trans          &trans
            >;
        };
    };
};
