/*
 * Colemak-DH V2 for the MX Corne (Typeractive, ZMK).
 * Generated by corne/make_zmk.py from corne/choc/Colemak-DH-V2.vil; edit the .vil or the script, not this file.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            display-name = "Base";
            bindings = <
            &kp ESC   &kp Q     &kp W     &kp F     &kp P     &kp B       &kp J     &kp L     &kp U     &kp Y     &kp SEMI  &kp PSCRN
            &kp LSHFT &kp A     &kp R     &kp S     &kp T     &kp G       &kp M     &kp N     &kp E     &kp I     &kp O     &kp SQT
            &kp LCTRL &kp Z     &kp X     &kp C     &kp D     &kp V       &kp K     &kp H     &kp COMMA &kp DOT   &kp FSLH  &kp RCTRL
                                          &kp LALT  &kp SPACE &lt 2 TAB   &mo 1     &kp BSPC  &kp RET
            >;
        };

        layer_1 {
            display-name = "NumSym";
            bindings = <
            &trans        &kp FSLH      &kp N7        &kp N8        &kp N9        &kp MINUS       &kp LBKT      &kp RBKT      &kp LS(N1)    &kp LS(N2)    &kp LS(N3)    &kp GRAVE
            &trans        &kp LS(N8)    &kp N4        &kp N5        &kp N6        &kp LS(EQUAL)   &kp LS(N9)    &kp LS(N0)    &kp LS(MINUS) &kp LS(N4)    &kp LS(N5)    &kp LS(GRAVE)
            &trans        &kp DOT       &kp N1        &kp N2        &kp N3        &kp EQUAL       &kp LS(LBKT)  &kp LS(RBKT)  &kp LS(N6)    &kp LS(N7)    &kp BSLH      &kp LS(BSLH)
                                                      &kp N0        &kp SPACE     &mo 3           &trans        &trans        &kp RGUI
            >;
        };

        layer_2 {
            display-name = "Nav";
            bindings = <
            &trans       &kp F10      &kp F7       &kp F8       &kp F9       &kp C_VOL_UP   &kp HOME     &kp PG_DN    &kp PG_UP    &kp END      &kp INS      &kp BSPC
            &trans       &kp F11      &kp F4       &kp F5       &kp F6       &kp C_VOL_DN   &kp LEFT     &kp DOWN     &kp UP       &kp RIGHT    &none        &trans
            &trans       &kp F12      &kp F1       &kp F2       &kp F3       &kp C_MUTE     &none        &none        &none        &none        &none        &trans
                                                   &kp LGUI     &trans       &trans         &mo 3        &trans       &kp RGUI
            >;
        };

        layer_3 {
            display-name = "System";
        // Hold both inner thumbs.
        // BT0-BT4: pick a Bluetooth slot. BTCLR: forget the current slot's pairing.
        // USB / BLE: where keys go when both are connected. UNLOCK: lets ZMK Studio change the keymap.
        // BOOT: the outer top key on each half puts that half in flashing mode (same as double-tapping reset).
            bindings = <
            &bootloader    &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3   &bt BT_SEL 4     &none          &none          &none          &none          &none          &bootloader
            &studio_unlock &none          &none          &none          &none          &none            &none          &none          &none          &none          &none          &none
            &bt BT_CLR     &out OUT_USB   &out OUT_BLE   &none          &none          &none            &none          &none          &none          &none          &none          &none
                                                         &kp LGUI       &trans         &trans           &trans         &trans         &kp RGUI
            >;
        };
    };
};
